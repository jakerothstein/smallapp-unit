# Generated by smallapp for unit notes. Edit smallapp inputs, not this file.
notes.example.com {
    tls internal

    handle /_smallapp/* {
        reverse_proxy 127.0.0.1:19500
    }

    forward_auth 127.0.0.1:19500 {
        uri /_smallapp/auth
        copy_headers X-Smallapp-User
    }

    root * /opt/smallapp/notes
    file_server
}
