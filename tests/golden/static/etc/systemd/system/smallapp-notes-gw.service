[Unit]
Description=smallapp notes auth gateway
Documentation=https://github.com/jakerothstein/smallapp-unit
After=network-online.target smallapp-notes.service
Wants=network-online.target

[Service]
Type=simple
User=sa-notes-gw
Group=sa-notes-gw
WorkingDirectory=/var/lib/smallapp/notes-gw
Environment=HOME=/var/lib/smallapp/notes-gw
EnvironmentFile=/etc/smallapp/notes.env
ExecStart=/usr/bin/env smallapp gateway
Restart=always
RestartSec=1
StateDirectory=smallapp/notes-gw
MemoryMax=128M
TasksMax=32
SocketBindAllow=tcp:19500
SocketBindDeny=any
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
IPAddressDeny=any
IPAddressAllow=localhost
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
RemoveIPC=yes
UMask=0077

[Install]
WantedBy=multi-user.target
