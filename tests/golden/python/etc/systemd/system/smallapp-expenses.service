[Unit]
Description=smallapp expenses (python)
Documentation=https://github.com/jakerothstein/smallapp-unit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sa-expenses
Group=sa-expenses
WorkingDirectory=/opt/smallapp/expenses
Environment=PORT=18412
Environment=HOME=/var/lib/smallapp/expenses
ExecStart=/usr/bin/env python3 /opt/smallapp/expenses/app.py
Restart=always
RestartSec=1
StateDirectory=smallapp/expenses
MemoryMax=512M
TasksMax=64
SocketBindAllow=tcp:18412
SocketBindDeny=any
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
RemoveIPC=yes
UMask=0077

[Install]
WantedBy=multi-user.target
