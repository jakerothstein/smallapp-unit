[Unit]
Description=smallapp expenses auth gateway
Documentation=https://github.com/jakerothstein/smallapp-unit
After=network-online.target smallapp-expenses.service
Wants=network-online.target

[Service]
Type=simple
User=sa-expenses-gw
Group=sa-expenses-gw
WorkingDirectory=/var/lib/smallapp/expenses-gw
Environment=HOME=/var/lib/smallapp/expenses-gw
EnvironmentFile=/etc/smallapp/expenses.env
ExecStart=/usr/bin/env smallapp gateway
Restart=always
RestartSec=1
StateDirectory=smallapp/expenses-gw
MemoryMax=128M
TasksMax=32
SocketBindAllow=tcp:19412
SocketBindDeny=any
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateUsers=yes
PrivateMounts=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed
RemoveIPC=yes
UMask=0077

[Install]
WantedBy=multi-user.target
